<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- EF Core migrations are generated/regenerated by `dotnet ef migrations add`,
               not hand-written — exclude from coverage same as any other generated code. -->
          <Exclude>[TodoApi.Todos]TodoApi.Todos.Persistence.Migrations.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
